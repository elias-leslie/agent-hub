# Copy to .env for Docker or .env.local for native development.
# Values below are placeholders; replace secrets before exposing the service.

# Docker compose infrastructure
POSTGRES_PASSWORD=change-me-postgres
HATCHET_TAG=v0.84.0

# Required backend services for native installs.
# Leave blank for Docker so compose can inject container-internal URLs.
AGENT_HUB_DB_URL=
AGENT_HUB_REDIS_URL=
TEST_AGENT_HUB_DB_URL=

# Native examples:
# AGENT_HUB_DB_URL=postgresql://agent_hub_app:CHANGE_ME@localhost:5432/agent_hub
# AGENT_HUB_REDIS_URL=redis://localhost:6379/2
# TEST_AGENT_HUB_DB_URL=postgresql://agent_hub_app:CHANGE_ME@localhost:5432/agent_hub_test

# Required secrets. Generate fresh values for each install.
AGENT_HUB_ENCRYPTION_KEY=
AGENT_HUB_SECRET_KEY=
INTERNAL_SERVICE_SECRET=

# Logging/debug
LOG_LEVEL=INFO
DEBUG=false

# First-party client registrations (optional for companion apps)
AGENT_HUB_DASHBOARD_CLIENT_ID=agent-hub-dashboard
AGENT_HUB_DASHBOARD_REQUEST_SOURCE=agent-hub-dashboard
NEXT_PUBLIC_AGENT_HUB_DASHBOARD_CLIENT_ID=agent-hub-dashboard
SUMMITFLOW_CLIENT_ID=
PORTFOLIO_CLIENT_ID=
MONKEY_FIGHT_CLIENT_ID=

# AI providers. Set only the providers you use.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
KIMI_CODE_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
XAI_API_KEY=
ZHIPU_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Optional local OpenAI-compatible endpoint
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_OPENAI_API_KEY=

# Hatchet
HATCHET_CLIENT_TOKEN=
HATCHET_TENANT_ID=
HATCHET_CLIENT_HOST_PORT=127.0.0.1:7070
HATCHET_CLIENT_TLS_STRATEGY=none

# Web push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Frontend rewrite targets
AGENT_HUB_API_URL=http://localhost:8003
SUMMITFLOW_API_URL=http://localhost:8001

# Optional MCP/local API override
AGENT_HUB_API=http://localhost:8003/api

# Optional browser/web research integrations
ST_BROWSER_HOST=
WEB_SEARCH_SEARXNG_URL=
WEB_FETCH_BROWSER_CDP_URL=

# Backend bind controls for native installs.
# Use 127.0.0.1 unless companion apps connect from another machine.
AGENT_HUB_BIND_HOST=127.0.0.1
