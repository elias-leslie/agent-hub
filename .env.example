# Agent Hub prefers repo-local .env.local / .env files.
# This root example covers shared, backend, frontend, and Docker compose values.

# Required backend services for native installs.
# Leave these blank for the bundled Docker quickstart so docker-compose can
# inject the container-internal service URLs automatically.
AGENT_HUB_DB_URL=
AGENT_HUB_REDIS_URL=
AGENT_HUB_ENCRYPTION_KEY=
AGENT_HUB_SECRET_KEY=

# Native example values:
# AGENT_HUB_DB_URL=postgresql://agent_hub_app:PASSWORD@localhost:5432/agent_hub
# AGENT_HUB_REDIS_URL=redis://localhost:6379/2

# Optional native test database
TEST_AGENT_HUB_DB_URL=
# TEST_AGENT_HUB_DB_URL=postgresql://agent_hub_app:PASSWORD@localhost:5432/agent_hub_test

# Optional internal auth / logging
INTERNAL_SERVICE_SECRET=
LOG_LEVEL=INFO
DEBUG=false

# Optional first-party client registrations.
# Set these when Agent Hub is installed standalone but should accept requests
# from companion apps without manual dashboard registration.
# Leave blank to use the built-in dashboard client id: agent-hub-dashboard
AGENT_HUB_DASHBOARD_CLIENT_ID=
# Leave blank to use the built-in request source: agent-hub-dashboard
AGENT_HUB_DASHBOARD_REQUEST_SOURCE=
NEXT_PUBLIC_AGENT_HUB_DASHBOARD_CLIENT_ID=
SUMMITFLOW_CLIENT_ID=
PORTFOLIO_CLIENT_ID=
MONKEY_FIGHT_CLIENT_ID=

# AI providers (set the ones you actually use)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
KIMI_CODE_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
XAI_API_KEY=
ZHIPU_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Optional local OpenAI-compatible endpoint
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_OPENAI_API_KEY=

# Hatchet
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=127.0.0.1:7070
HATCHET_CLIENT_TLS_STRATEGY=none

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@summitflow.dev

# Frontend rewrite targets
AGENT_HUB_API_URL=http://localhost:8003
SUMMITFLOW_API_URL=http://localhost:8001

# Optional MCP / local API override
AGENT_HUB_API=http://localhost:8003/api

# Shared browser / web research infrastructure
ST_BROWSER_HOST=192.168.8.244
WEB_SEARCH_SEARXNG_URL=
WEB_FETCH_BROWSER_CDP_URL=

# Backend bind controls for native systemd installs.
# Use 127.0.0.1 only when companion apps will never connect from another machine.
AGENT_HUB_BIND_HOST=0.0.0.0
AGENT_HUB_PORT=8003

# CORS origins are comma-separated in Agent Hub
CORS_ORIGINS=http://localhost:3003,https://agent.summitflow.dev

# ---------------------------------------------------------------------------
# Docker compose
# ---------------------------------------------------------------------------

# Host ports for the standalone Docker stack.
# AGENT_HUB_FRONTEND_HOST_PORT=3003
# AGENT_HUB_BACKEND_HOST_PORT=8003
# AGENT_HUB_DB_HOST_PORT=5432
# AGENT_HUB_REDIS_HOST_PORT=6379
# HATCHET_GRPC_HOST_PORT=7070
# HATCHET_HEALTH_HOST_PORT=8888

# Postgres password for the bundled Docker stack.
# POSTGRES_PASSWORD=agent_hub

# Hatchet quickstart configuration.
# scripts/generate-hatchet-dev-token.sh writes both HATCHET_TENANT_ID and
# HATCHET_CLIENT_TOKEN for the quickstart tenant.
# HATCHET_TAG=latest
# HATCHET_TENANT_ID=
