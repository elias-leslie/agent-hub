# Agent Hub reads settings from ~/.env.local by default.
# This root example complements backend/.env.example with shared and frontend
# values used for local development.

# Required backend services
AGENT_HUB_DB_URL=postgresql://agent_hub_app:PASSWORD@localhost:5432/agent_hub
AGENT_HUB_REDIS_URL=redis://localhost:6379/2
AGENT_HUB_ENCRYPTION_KEY=
AGENT_HUB_SECRET_KEY=

# Optional test database
TEST_AGENT_HUB_DB_URL=postgresql://agent_hub_app:PASSWORD@localhost:5432/agent_hub_test

# Optional internal auth / logging
INTERNAL_SERVICE_SECRET=
LOG_LEVEL=INFO
DEBUG=false

# AI providers (set the ones you actually use)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Hatchet
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=none

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@summitflow.dev

# Frontend rewrite targets
AGENT_HUB_API_URL=http://localhost:8003
SUMMITFLOW_API_URL=http://localhost:8001

# Optional MCP / local API override
AGENT_HUB_API=http://localhost:8003/api

# CORS origins are comma-separated in Agent Hub
CORS_ORIGINS=http://localhost:3003,https://agent.summitflow.dev
