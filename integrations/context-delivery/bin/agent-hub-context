#!/usr/bin/env bash
# Source-linked entry point for the canonical Agent Hub context CLI.
set -euo pipefail

SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SOURCE")/../../.." && pwd)"
PYTHON="$ROOT/backend/.venv/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    # A remote agent host has no backend: deliver over the API with its host token.
    if [[ -f "$ROOT/integrations/context-delivery/bin/agent-hub-context-remote" && ! -d "$ROOT/backend/.venv" ]]; then
        exec python3 "$ROOT/integrations/context-delivery/bin/agent-hub-context-remote" "$@"
    fi
    echo "agent-hub-context: backend Python runtime missing at $PYTHON" >&2
    exit 127
fi
export PYTHONPATH="$ROOT/backend${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m app.cli.runtime_context "$@"
