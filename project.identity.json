{
  "schema_version": 1,
  "project": {
    "id": "agent-hub",
    "repo_name": "agent-hub",
    "display_name": "Agent-Hub"
  },
  "branding": {
    "short_name": "Agent-Hub",
    "description": "Companion service for agent orchestration, model access, and voice workflows."
  },
  "runtime": {
    "backend_port": 8003,
    "frontend_port": 3003,
    "backend_dir": "backend",
    "backend_extras": ["compression"],
    "frontend_dir": "frontend",
    "health_endpoint": "/health"
  },
  "database": {
    "name": "agent_hub",
    "owner_role": "agent_hub_app",
    "test": {"name": "agent_hub_test", "owner": "agent_hub_app"}
  },
  "images": [
    {"dockerfile": "docker/backend.Dockerfile", "name": "agent-hub-api"},
    {"dockerfile": "docker/frontend.Dockerfile", "name": "agent-hub-web"}
  ],
  "services": {
    "backend": "agent-hub-backend.service",
    "frontend": "agent-hub-frontend.service",
    "default_workers": [
      "agent-hub-hatchet-ops-worker.service",
      "codex-session-sync.timer",
      "codex-session-close-inactive.timer"
    ],
    "optional_workers": [
      "agent-hub-hatchet-agent-worker.service"
    ]
  },
  "hosts": {
    "production_frontend": "localhost:3003",
    "production_api": "localhost:8003"
  },
  "repository": {
    "owner": "elias-leslie",
    "name": "agent-hub",
    "ssh_url": "git@github.com:elias-leslie/agent-hub.git",
    "https_url": "https://github.com/elias-leslie/agent-hub"
  }
}
