[Unit]
Description=Agent Hub Jenny Telegram status report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__PROJECT_ROOT__/backend
Environment="PYTHONUNBUFFERED=1"
ExecStart=/bin/bash -lc '__PROJECT_ROOT__/backend/.venv/bin/python -m app.scripts.send_jenny_telegram_status_report'
KillMode=control-group
