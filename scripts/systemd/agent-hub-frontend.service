[Unit]
Description=Agent Hub Frontend (Next.js)
After=network.target agent-hub-backend.service
Wants=agent-hub-backend.service

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__/frontend
Environment="HOME=%h"
EnvironmentFile=-%h/.env.local
Environment="NODE_ENV=production"
Environment="PORT=3003"
Environment="AGENT_HUB_API_URL=http://localhost:8003"
Environment="SUMMITFLOW_API_URL=http://localhost:8001"
ExecStart=/bin/bash -lc "pnpm start --hostname 0.0.0.0 --port 3003"
TimeoutStopSec=10
KillMode=control-group
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub-frontend

[Install]
WantedBy=default.target
