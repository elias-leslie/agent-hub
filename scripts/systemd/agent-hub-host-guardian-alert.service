[Unit]
Description=Deliver host guardian state changes through configured Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__PROJECT_ROOT__/backend
Environment="PYTHONUNBUFFERED=1"
ExecStart=__PROJECT_ROOT__/backend/.venv/bin/python -m app.scripts.send_host_guardian_alerts
KillMode=control-group

