[Unit]
Description=agent-hub backend (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__/backend
Environment="PATH=%h/bin:%h/.local/bin:__SUMMITFLOW_ROOT__/backend/.venv/bin:__PROJECT_ROOT__/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME=%h"
EnvironmentFile=-%h/.env.local
Environment="PYTHONUNBUFFERED=1"
Environment="HATCHET_CLIENT_HOST_PORT=127.0.0.1:7070"
Environment="HATCHET_CLIENT_TLS_STRATEGY=none"
ExecStart=/bin/bash -lc '__PROJECT_ROOT__/backend/.venv/bin/uvicorn app.main:app --host "${AGENT_HUB_BIND_HOST:-0.0.0.0}" --port "${AGENT_HUB_PORT:-8003}"'
Restart=always
RestartSec=10

# Zombie prevention - kill entire cgroup on stop
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub-backend

[Install]
WantedBy=default.target
