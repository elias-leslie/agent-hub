[Unit]
Description=agent-hub backend (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/agent-hub/backend
Environment="PATH=%h/bin:%h/.local/bin:%h/summitflow/backend/.venv/bin:%h/agent-hub/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME=%h"
EnvironmentFile=-%h/.env.local
Environment="PYTHONUNBUFFERED=1"
Environment="HATCHET_CLIENT_HOST_PORT=127.0.0.1:7070"
Environment="HATCHET_CLIENT_TLS_STRATEGY=none"
ExecStart=%h/agent-hub/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8003
Restart=always
RestartSec=10

# Zombie prevention - kill entire cgroup on stop
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-hub-backend

[Install]
WantedBy=default.target
