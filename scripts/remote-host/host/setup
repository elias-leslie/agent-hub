#!/usr/bin/env bash
# Host half of scripts/remote-host/bootstrap; runs on the agent host as its
# user (sudo for the system parts). Re-runnable: every step converges.
# Usage: setup <claude-version> <pi-version> <host-name> < home-links.tsv
set -euo pipefail

claude_version=$1 pi_version=$2 host_name=$3
lib=/usr/local/lib/agent-host
projects=/srv/workspaces/projects
cred_bin=$HOME/.local/lib/agent-hub/cred-bin
state=$HOME/.local/state/agent-host
# Credential shims (Agent Hub's agent-hub-cred-exec) go first, then the
# context launchers, then the real binaries, as on the workstation; rustup's
# cargo/rustc proxies after the local bins.
agent_path="$cred_bin:$HOME/.claude/bin:$HOME/.codex/bin:$HOME/bin:$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
export PATH="$agent_path"

say() { printf 'setup: %s\n' "$*"; }

# Write $2 to file $1 only when it differs; print whether it changed.
put() {
    local target=$1 content=$2
    if [[ -f $target ]] && [[ $(cat -- "$target") == "$content" ]]; then return 1; fi
    mkdir -p -- "$(dirname -- "$target")"
    printf '%s\n' "$content" >"$target.tmp.$$" && mv -f -- "$target.tmp.$$" "$target"
    say "wrote ${target/#$HOME/\~}"
}

link() {
    local path=$1 target=$2
    if [[ -e $path && ! -L $path ]]; then
        say "kept ${path/#$HOME/\~}: a real file is there, not a link"
        return 0
    fi
    [[ -L $path && $(readlink -- "$path") == "$target" ]] && return 0
    mkdir -p -- "$(dirname -- "$path")"
    ln -sfn -- "$target" "$path"
    say "linked ${path/#$HOME/\~} -> $target"
}

# --- Agent Hub identity ---------------------------------------------------
# A clone of another host's snapshot carries that host's Agent Hub token. Its
# host name comes from Agent Hub, or from the tool map cached with that token
# while Agent Hub is unreachable.
if [[ -s $HOME/.config/agent-hub/host-token ]]; then
    token_host=$("$projects/agent-hub/integrations/remote-host/agent-hub-host" login status --json 2>/dev/null \
        | python3 -c 'import json, sys; print(json.load(sys.stdin).get("host") or "")' || true)
    if [[ -n $token_host && $token_host != "$host_name" ]]; then
        # shellcheck disable=SC2088 # a path shown to the reader, not expanded
        say "The host token (~/.config/agent-hub/host-token) belongs to host $token_host, not $host_name."
        say "Enrol this host fresh: rm ~/.config/agent-hub/host-token ~/.config/agent-hub/tool-map.json, then README step 4."
        exit 1
    fi
fi

# --- system: shared paths, idle poweroff ---------------------------------
# The checkouts must really live at the workstation's path: git and getcwd
# report resolved paths, and Agent Hub matches those against its project
# roots. A template that links the projects dir elsewhere gets the two
# swapped (a rename on the same disk), keeping the old path as a link.
if [[ -L $projects ]]; then
    real=$(readlink -f -- "$projects")
    sudo -n rm -- "$projects"
    sudo -n mv -T -- "$real" "$projects"
    sudo -n ln -s -- "$projects" "$real"
    say "moved $real to $projects (old path is now a link)"
fi
if [[ ! -e /srv/scratch ]]; then
    sudo -n ln -s /work/scratch /srv/scratch
    say "linked /srv/scratch -> /work/scratch"
fi
sudo -n install -d -m 0755 /etc/agent-host
if [[ ! -f /etc/agent-host/idle.conf ]]; then
    sudo -n install -m 0644 "$lib/idle.conf" /etc/agent-host/idle.conf
    say "installed /etc/agent-host/idle.conf"
else
    # Keep the host's edits; add only the keys (with their comments) it lacks.
    added=$(python3 - "$lib/idle.conf" /etc/agent-host/idle.conf <<'PY'
import sys
shipped, current = (open(path, encoding="utf-8").read().splitlines() for path in sys.argv[1:])
have = {line.partition("=")[0].strip() for line in current if "=" in line and not line.lstrip().startswith("#")}
block: list[str] = []
for line in shipped:
    block.append(line)
    if "=" in line and not line.lstrip().startswith("#"):
        if line.partition("=")[0].strip() not in have:
            print("\n".join(block))
        block = []
PY
    )
    if [[ -n $added ]]; then
        printf '%s\n' "$added" | sudo -n tee -a /etc/agent-host/idle.conf >/dev/null
        say "added new keys to /etc/agent-host/idle.conf: $(grep -v '^#' <<<"$added" | cut -d= -f1 | xargs)"
    fi
fi

# sshd: room for every terminal on the link's one connection, and dead-link
# detection. Validated before the reload; a reload keeps open connections.
sshd_dropin=/etc/ssh/sshd_config.d/50-agent-host.conf
if ! cmp -s "$lib/sshd-agent-host.conf" "$sshd_dropin" || [[ -e /etc/ssh/sshd_config.d/50-agent-work.conf ]]; then
    sudo -n install -m 0644 "$lib/sshd-agent-host.conf" "$sshd_dropin"
    # The hand-written drop-in it replaces (ClientAlive lines only).
    sudo -n rm -f /etc/ssh/sshd_config.d/50-agent-work.conf
    if ! sudo -n sshd -t; then
        sudo -n rm -f "$sshd_dropin"
        say "sshd rejected $sshd_dropin; removed it"
        exit 1
    fi
    sudo -n systemctl reload ssh.service
    say "installed $sshd_dropin and reloaded sshd"
fi
units_changed=0
for unit in agent-host-idle.service agent-host-idle.timer agent-hub-codex-sync@.service agent-hub-codex-sync@.timer; do
    if ! cmp -s "$lib/systemd/$unit" "/etc/systemd/system/$unit"; then
        sudo -n install -m 0644 "$lib/systemd/$unit" "/etc/systemd/system/$unit"
        units_changed=1
        say "installed /etc/systemd/system/$unit"
    fi
done
((units_changed)) && sudo -n systemctl daemon-reload
sudo -n systemctl enable --now --quiet agent-host-idle.timer
sudo -n systemctl enable --now --quiet "agent-hub-codex-sync@$(id -un).timer"

# --- toolchains the template lacks --------------------------------------
# Rust for hunts and labs on Rust targets: Ubuntu's rustup with a minimal
# stable toolchain. A rustup already in ~/.cargo (installed by hand) is kept.
if ! command -v rustup >/dev/null; then
    sudo -n apt-get install -y -qq rustup >/dev/null
    say "installed rustup"
fi
if ! rustup default 2>/dev/null | grep -q .; then
    rustup set profile minimal >/dev/null 2>&1
    rustup default stable >/dev/null 2>&1
    say "installed the stable Rust toolchain"
fi

# --- harness binaries (copied by bootstrap) and launch links -------------
link "$HOME/.local/bin/claude" "$HOME/.local/share/claude/versions/$claude_version"
link "$HOME/.local/bin/codex" ../lib/node_modules/@openai/codex/bin/codex.js
link "$HOME/.local/bin/codex-real" ../lib/node_modules/@openai/codex/bin/codex.js
link "$HOME/.local/bin/pi" "$HOME/.pi/agent/bin/pi"
link "$HOME/bin/st" "$lib/st"
mkdir -p "$cred_bin"

# Workstation home links into the mirrored checkouts.
while IFS=$'\t' read -r kind path target; do
    [[ $kind == link ]] && link "$HOME/$path" "$target"
done

# Canonical context adapters (Agent Hub owns the installer).
python3 "$projects/agent-hub/integrations/context-delivery/install.py" >/dev/null
python3 "$projects/agent-hub/integrations/context-delivery/install.py" --check >/dev/null
say "context adapters installed and checked"

# Claude Code's first-run screens (theme, notes, folder trust) would stop an
# unattended launch: mark onboarding done and trust the mirrored checkouts and
# the blank-slate folder, as on the workstation. Logins are not touched.
python3 - "$HOME/.claude.json" "$claude_version" "$projects" /tmp/aico-blank-slate <<'PY'
import json, os, sys
path, version, projects, blank = sys.argv[1:]
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
except FileNotFoundError:
    data = {}
before = json.dumps(data, sort_keys=True)
data["hasCompletedOnboarding"] = True
data.setdefault("lastOnboardingVersion", version)
folders = [os.path.join(projects, n) for n in sorted(os.listdir(projects))
           if os.path.isdir(os.path.join(projects, n, ".git"))] + [blank]
for folder in folders:
    data.setdefault("projects", {}).setdefault(folder, {})["hasTrustDialogAccepted"] = True
if json.dumps(data, sort_keys=True) != before:
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)
    print("setup: Claude Code onboarding done; trusted " + ", ".join(folders))
PY

# st runs from the summitflow checkout's backend environment.
(cd "$projects/summitflow/backend" && uv sync --locked --quiet)
say "summitflow backend environment synced"

# --- login PATH and Tether -----------------------------------------------
profile_block="# >>> agent-host PATH (scripts/remote-host) >>>
PATH=\"$agent_path:\$PATH\"
# <<< agent-host PATH <<<"
# ~/.profile covers login shells; ~/.bashrc covers non-interactive `ssh host cmd`,
# so its block goes first, ahead of Ubuntu's early return for non-interactive shells.
for rc in .profile .bashrc; do
    if ! grep -qF '# >>> agent-host PATH' "$HOME/$rc" 2>/dev/null; then
        if [[ $rc == .bashrc ]]; then
            printf '%s\n\n' "$profile_block" | cat - "$HOME/$rc" 2>/dev/null >"$HOME/$rc.tmp.$$"
            mv -f -- "$HOME/$rc.tmp.$$" "$HOME/$rc"
        else
            printf '\n%s\n' "$profile_block" >>"$HOME/$rc"
        fi
        say "added the agent PATH to ~/$rc"
    elif ! grep -qF "PATH=\"$agent_path:" "$HOME/$rc"; then
        python3 - "$HOME/$rc" "$profile_block" <<'PY'
import re, sys
path, block = sys.argv[1], sys.argv[2]
text = open(path, encoding="utf-8").read()
text = re.sub(r"# >>> agent-host PATH.*?# <<< agent-host PATH <<<", lambda _m: block, text, flags=re.S)
open(path, "w", encoding="utf-8").write(text)
PY
        say "updated the agent PATH in ~/$rc"
    fi
done

tether_changed=0
unit_dir=$HOME/.config/systemd/user
if ! cmp -s "$projects/aico/tether/systemd/tether@.service" "$unit_dir/tether@.service"; then
    install -D -m 0644 "$projects/aico/tether/systemd/tether@.service" "$unit_dir/tether@.service"
    tether_changed=1
    say "installed tether@.service from the aico checkout"
fi
put "$unit_dir/tether@default.service.d/remote.conf" "# Agent host (scripts/remote-host): no desktop, workstation paths, agent PATH.
[Service]
Environment=TETHER_HEADLESS=1
Environment=TETHER_PROJECTS_DIR=$projects
Environment=PATH=$agent_path" && tether_changed=1
sock=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/tether/default/control.sock
# The bundle digest decides whether the running daemon is stale.
bundle_digest=$(cd "$HOME/.local/lib/tether" && find bin dist scripts shims -type f -not -path '*/__pycache__/*' -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)
mkdir -p "$state"
if [[ $(cat "$state/tether-bundle.sha256" 2>/dev/null) != "$bundle_digest" ]]; then
    tether_changed=1
fi
systemctl --user daemon-reload
systemctl --user enable --quiet tether@default.service
if ((tether_changed)) || ! systemctl --user is-active --quiet tether@default.service; then
    # A restart never stops a pane: tmux servers are separate units.
    systemctl --user restart tether@default.service
    say "restarted tether@default"
fi
printf '%s\n' "$bundle_digest" >"$state/tether-bundle.sha256"

for _ in $(seq 1 30); do
    curl -sf --unix-socket "$sock" http://tether/v1/health >/dev/null && break
    sleep 1
done
curl -sf --unix-socket "$sock" http://tether/v1/health >/dev/null \
    || { say "Tether did not answer its health check"; exit 1; }
say "done: claude $claude_version, $(codex --version), pi $pi_version, agy $(agy --version 2>/dev/null | head -1); Tether healthy"
