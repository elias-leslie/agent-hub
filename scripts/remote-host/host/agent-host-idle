#!/usr/bin/env python3
"""Power an agent host off once it has been idle long enough.

Run by agent-host-idle.timer as root. Idle means all of these at once:
zero Tether sessions, no pending Tether wakes, load below the limit, no
ssh connection carrying a command or shell (the Tether link is `ssh -N`, so
its sshd process has no children), and no user work: no process left in a
user slice outside Tether's own units and the usual user-manager daemons, so
a detached `setsid`/`nohup` job, a stray tmux or a `systemd-run --user` unit
keeps the host up however little CPU it uses. Running containers and root
`systemd-run` jobs (transient system units) count as work too. Thresholds and
the ignored units and commands come from the config file.
Anything that cannot be read counts as busy: unknown is never idle.
Every run logs one line saying why the host stays up or powers off.
"""

from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import socket
import subprocess
import sys
import time
from dataclasses import dataclass
from fnmatch import fnmatchcase
from pathlib import Path
from typing import Any

DEFAULT_CONFIG = Path("/etc/agent-host/idle.conf")
STATE_DIR = Path("/run/agent-host-idle")
# An unprivileged per-connection sshd process: `sshd: user...` before OpenSSH
# 9.8, `sshd-session: user...` from 9.8 on.
SSHD_CONNECTION = re.compile(r"^sshd(-session)?: ")


@dataclass(frozen=True)
class Config:
    enabled: bool
    idle_minutes: float
    load_max: float
    load_window: int
    tether_socket: str
    ignore_units: tuple[str, ...] = ()
    ignore_commands: tuple[str, ...] = ()
    ignore_system_units: tuple[str, ...] = ()


def load_config(path: Path) -> Config:
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        if sep:
            values[key.strip()] = value.strip().strip('"')
    window = int(values.get("LOAD_WINDOW", "5"))
    if window not in (1, 5, 15):
        raise ValueError(f"LOAD_WINDOW must be 1, 5 or 15, not {window}")
    return Config(
        enabled=values.get("ENABLED", "1") == "1",
        idle_minutes=float(values["IDLE_MINUTES"]),
        load_max=float(values["LOAD_MAX"]),
        load_window=window,
        tether_socket=values["TETHER_SOCKET"],
        ignore_units=tuple(values["IGNORE_UNITS"].split()),
        ignore_commands=tuple(values["IGNORE_COMMANDS"].split()),
        ignore_system_units=tuple(values.get("IGNORE_SYSTEM_UNITS", "").split()),
    )


class _UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, path: str, timeout: float) -> None:
        super().__init__("tether", timeout=timeout)
        self._path = path

    def connect(self) -> None:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(self.timeout)
        sock.connect(self._path)
        self.sock = sock


def tether_get(socket_path: str, path: str, timeout: float = 5.0) -> dict:
    conn = _UnixHTTPConnection(socket_path, timeout)
    try:
        conn.request("GET", path)
        response = conn.getresponse()
        body = response.read()
        if response.status != 200:
            raise RuntimeError(f"{path} answered HTTP {response.status}")
        return json.loads(body)
    finally:
        conn.close()


def load_average(window: int) -> float:
    fields = Path("/proc/loadavg").read_text(encoding="ascii").split()
    return float(fields[{1: 0, 5: 1, 15: 2}[window]])


def ssh_sessions(proc: Path = Path("/proc")) -> int:
    """Count ssh connections that run a command or shell.

    Each connection has an unprivileged `sshd[-session]: user...` process. `ssh -N`
    (the Tether link) never forks under it; a shell, command or multiplexed
    session does.
    """
    parents: dict[int, int] = {}
    connections: set[int] = set()
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / "stat").read_text(encoding="utf-8", errors="replace")
            cmdline = (entry / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
        except OSError:
            continue
        ppid = int(stat.rsplit(")", 1)[1].split()[1])
        pid = int(entry.name)
        parents[pid] = ppid
        if SSHD_CONNECTION.match(cmdline) and not cmdline.endswith(("[priv]", "[net]")) and "[listener]" not in cmdline:
            connections.add(pid)
    busy = {ppid for ppid in parents.values() if ppid in connections}
    return len(busy)


def own_cgroup() -> str | None:
    """This process's cgroup, so a check run over ssh leaves its own session out."""
    try:
        return _cgroup(Path("/proc/self"))
    except OSError:
        return None


def _cgroup(entry: Path) -> str:
    for line in (entry / "cgroup").read_text(encoding="utf-8").splitlines():
        if line.startswith("0::"):
            return line[3:]
    return ""


def user_work(config: Config, proc: Path = Path("/proc"), exclude_cgroup: str | None = None) -> list[str]:
    """Command names of processes in a user slice that count as work.

    Left out: Tether's own units (its sessions are counted on their own), the
    user manager and its daemons (IGNORE_UNITS, matched against each unit in
    the process's cgroup path), sshd's own processes (IGNORE_COMMANDS; the
    ssh check covers connections), zombies and `exclude_cgroup`.
    """
    found: list[str] = []
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            cgroup = _cgroup(entry)
            if not cgroup.startswith("/user.slice/") or cgroup == exclude_cgroup:
                continue
            comm = (entry / "comm").read_text(encoding="utf-8", errors="replace").strip()
            state = (entry / "stat").read_text(encoding="utf-8", errors="replace").rsplit(")", 1)[1].split()[0]
        except (OSError, IndexError):
            continue  # gone while we looked
        if state == "Z" or comm in config.ignore_commands:
            continue
        units = cgroup.split("/")
        if any(fnmatchcase(unit, pattern) for unit in units for pattern in config.ignore_units):
            continue
        found.append(comm)
    return sorted(found)


def containers(run: Any = None) -> int:
    """Running containers; none without docker. Raises when docker can't answer."""
    run = run or subprocess.run
    try:
        answer = run(["docker", "ps", "-q"], capture_output=True, text=True, check=False)
    except FileNotFoundError:
        return 0
    if answer.returncode != 0:
        raise RuntimeError(answer.stderr.strip() or f"docker ps exited {answer.returncode}")
    return len(answer.stdout.split())


def system_jobs(config: Config, run: Any = None) -> list[str]:
    """Running transient units in system.slice (root `systemd-run` jobs), except
    IGNORE_SYSTEM_UNITS (a container's own scope is counted as a container)."""
    run = run or subprocess.run
    listed = run(
        ["systemctl", "list-units", "--type=service,scope", "--state=running", "--no-legend", "--plain"],
        capture_output=True, text=True, check=False,
    )
    if listed.returncode != 0:
        raise RuntimeError(f"systemctl list-units exited {listed.returncode}")
    names = [line.split()[0] for line in listed.stdout.splitlines() if line.strip()]
    if not names:
        return []
    shown = run(
        ["systemctl", "show", "--property=Id,Transient,Slice", "--", *names],
        capture_output=True, text=True, check=False,
    )
    if shown.returncode != 0:
        raise RuntimeError(f"systemctl show exited {shown.returncode}")
    found: list[str] = []
    for block in shown.stdout.strip().split("\n\n"):
        props = dict(line.partition("=")[::2] for line in block.splitlines() if "=" in line)
        unit = props.get("Id", "")
        if props.get("Transient") != "yes" or props.get("Slice") != "system.slice":
            continue
        if any(fnmatchcase(unit, pattern) for pattern in config.ignore_system_units):
            continue
        found.append(unit)
    return sorted(found)


@dataclass(frozen=True)
class Reading:
    sessions: int | None
    wakes: int | None
    load: float | None
    ssh: int | None
    errors: tuple[str, ...]
    work: tuple[str, ...] = ()
    containers: int = 0
    jobs: tuple[str, ...] = ()


def read_host(config: Config, exclude_cgroup: str | None = None) -> Reading:
    errors: list[str] = []
    sessions = wakes = ssh = None
    load = None
    work: tuple[str, ...] = ()
    running = 0
    jobs: tuple[str, ...] = ()
    try:
        sessions = len(tether_get(config.tether_socket, "/v1/sessions")["items"])
        wakes = len(tether_get(config.tether_socket, "/v1/wakes")["items"])
    except (OSError, http.client.HTTPException, RuntimeError, ValueError, KeyError, TypeError) as exc:
        errors.append(f"Tether unreadable ({type(exc).__name__}: {exc})")
    try:
        load = load_average(config.load_window)
    except (OSError, ValueError) as exc:
        errors.append(f"load unreadable ({exc})")
    try:
        ssh = ssh_sessions()
    except OSError as exc:
        errors.append(f"ssh sessions unreadable ({exc})")
    try:
        work = tuple(user_work(config, exclude_cgroup=exclude_cgroup))
    except OSError as exc:
        errors.append(f"user processes unreadable ({exc})")
    try:
        running = containers()
    except (OSError, RuntimeError) as exc:
        errors.append(f"containers unreadable ({exc})")
    try:
        jobs = tuple(system_jobs(config))
    except (OSError, RuntimeError, IndexError) as exc:
        errors.append(f"system units unreadable ({exc})")
    return Reading(sessions, wakes, load, ssh, tuple(errors), work, running, jobs)


def busy_reasons(reading: Reading, config: Config) -> list[str]:
    reasons = list(reading.errors)
    if reading.sessions:
        reasons.append(f"{reading.sessions} Aico session(s) open")
    if reading.wakes:
        reasons.append(f"{reading.wakes} scheduled check-in(s)")
    if reading.load is not None and reading.load >= config.load_max:
        reasons.append(f"load {reading.load:.2f} >= {config.load_max:g}")
    if reading.ssh:
        reasons.append(f"{reading.ssh} ssh login(s) besides Aico's link")
    if reading.work:
        names = sorted(set(reading.work))
        shown = ", ".join(names[:5]) + (", ..." if len(names) > 5 else "")
        reasons.append(f"{len(reading.work)} program(s) still running outside Aico sessions ({shown})")
    if reading.containers:
        reasons.append(f"{reading.containers} running container(s)")
    if reading.jobs:
        shown = ", ".join(reading.jobs[:5]) + (", ..." if len(reading.jobs) > 5 else "")
        reasons.append(f"{len(reading.jobs)} background job(s) run as root ({shown})")
    return reasons


def decide(reading: Reading, config: Config, idle_since: float | None, now: float) -> tuple[str, str]:
    """Return (action, message); action is busy, idle or poweroff."""
    if not config.enabled:
        return "busy", "stay up: idle poweroff is disabled (ENABLED=0)"
    reasons = busy_reasons(reading, config)
    if reasons:
        return "busy", "stay up: " + "; ".join(reasons)
    summary = (
        f"0 sessions, 0 wakes, load {reading.load:.2f} < {config.load_max:g}, "
        "no ssh sessions besides the link, no user processes, containers or root jobs"
    )
    idle_minutes = 0.0 if idle_since is None else (now - idle_since) / 60
    if idle_minutes >= config.idle_minutes:
        return "poweroff", f"power off: idle {idle_minutes:.0f} min ({summary})"
    return "idle", f"stay up: idle {idle_minutes:.0f} of {config.idle_minutes:g} min ({summary})"


def _read_since(path: Path) -> float | None:
    try:
        return float(path.read_text(encoding="ascii").strip())
    except (OSError, ValueError):
        return None


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    parser.add_argument("--dry-run", action="store_true", help="Print the decision; change nothing.")
    args = parser.parse_args(argv)
    try:
        config = load_config(args.config)
    except (OSError, ValueError, KeyError) as exc:
        print(f"stay up: config {args.config} unreadable ({exc})")
        return 1
    since_file = STATE_DIR / "idle-since"
    now = time.time()
    reading = read_host(config, exclude_cgroup=own_cgroup())
    action, message = decide(reading, config, _read_since(since_file), now)
    if args.dry_run:
        print(f"dry run: {message}")
        return 0
    if action == "busy":
        since_file.unlink(missing_ok=True)
    elif not since_file.exists():
        STATE_DIR.mkdir(mode=0o700, exist_ok=True)
        since_file.write_text(f"{now}\n", encoding="ascii")
    print(message, flush=True)
    if action == "poweroff":
        since_file.unlink(missing_ok=True)
        os.sync()
        return subprocess.run(["systemctl", "poweroff", "--no-ask-password"], check=False).returncode
    return 0


if __name__ == "__main__":
    sys.exit(main())
