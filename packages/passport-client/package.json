{
    "name": "@agent-hub/passport-client",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "development": {
                "types": "./src/index.ts",
                "default": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./core": {
            "development": {
                "types": "./src/core/index.ts",
                "default": "./src/core/index.ts"
            },
            "import": {
                "types": "./dist/core/index.d.ts",
                "default": "./dist/core/index.js"
            },
            "require": {
                "types": "./dist/core/index.d.cts",
                "default": "./dist/core/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "prepack": "pnpm run build"
    },
    "peerDependencies": {
        "react": ">=18 || ^19.0.0",
        "react-dom": ">=18 || ^19.0.0"
    },
    "dependencies": {
        "clsx": "^2.1.0",
        "lucide-react": "^0.562.0",
        "tailwind-merge": "^2.2.0"
    },
    "devDependencies": {
        "@types/react": "19",
        "@types/react-dom": "^19.2.3",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "import": {
                    "types": "./dist/index.d.ts",
                    "default": "./dist/index.js"
                },
                "require": {
                    "types": "./dist/index.d.cts",
                    "default": "./dist/index.cjs"
                }
            },
            "./core": {
                "import": {
                    "types": "./dist/core/index.d.ts",
                    "default": "./dist/core/index.js"
                },
                "require": {
                    "types": "./dist/core/index.d.cts",
                    "default": "./dist/core/index.cjs"
                }
            }
        }
    }
}
