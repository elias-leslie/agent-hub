{
    "name": "@agent-hub/sdk",
    "version": "0.1.0",
    "description": "TypeScript client for Agent Hub: turns, sessions, models, agents, live events and workflow runs. No runtime dependencies; works in browsers, Electron and Node 22.",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "development": {
                "types": "./src/index.ts",
                "default": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "prepack": "pnpm run build"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.3.0",
        "vitest": "^5.0.4"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "import": {
                    "types": "./dist/index.d.ts",
                    "default": "./dist/index.js"
                },
                "require": {
                    "types": "./dist/index.d.cts",
                    "default": "./dist/index.cjs"
                }
            }
        }
    }
}
